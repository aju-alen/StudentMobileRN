{
  "expo": {
    "name": "Coach Academ",
    "slug": "coach-academ",
    "scheme": "coachacadem",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rise.coachacadem",
      "icon": "./assets/images/ca_logo_android.png",
      "associatedDomains": [
        "applinks:www.coachacadem.ae",
        "applinks:coachacadem.ae"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Coach Academ uses the microphone so you can send voice notes in messages."
      },
      "buildNumber": "62"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "versionCode": 62,
      "icon": "./assets/images/playstore-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/playstore-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rise.coachacadem",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.coachacadem.ae",
              "pathPrefix": "/teacher"
            },
            {
              "scheme": "https",
              "host": "coachacadem.ae",
              "pathPrefix": "/teacher"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos so you can send images in messages.",
          "cameraPermission": "The app accesses your camera so you can take photos for messages."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Coach Academ uses the microphone so you can send voice notes in messages."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "ca_sentry",
          "organization": "rise-ltd"
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-notifications",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://www.coachacadem.ae"
      },
      "eas": {
        "projectId": "87c73a97-3029-41b3-be21-54a03a8ad464"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/87c73a97-3029-41b3-be21-54a03a8ad464"
    }
  }
}
